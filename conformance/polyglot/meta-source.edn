;; One registry, implemented in two languages: shop.price (Clojure, src/)
;; and the receipt page (TypeScript, web/). Each reader indexes the code in
;; its own language; about the registry, both must answer the same.
{:registry ["registry"]
 :src ["src" "web"]
 :dataflow {:consumes [:fn/reads] :produces [:fn/returns]}
 ;; what an entry key's ids are: a dependency, a relation of the page's own
 ;; that is a dependency too,
 ;; and a verb neither reserved nor qualified, which no reader understands
 :relations {:fn/calls {:verb :depends}
             :page/shows {:verb :page/shows :depends true}
             :app/tags {:verb :tags}}
 :merge {:app/tags :union}}
