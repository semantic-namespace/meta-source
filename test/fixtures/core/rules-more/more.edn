;; Each condition, against the shop's facts.
{:more/fns-outside-shop-ns
 {:when {:has :fn/reads :not {:id-ns "shop"}}
  :require [{:has :owner/team}]}

 :more/privacy-is-a-known-class
 {:when {:has :data/privacy}
  :require [{:in {:data/privacy #{:pii :public}}}]}

 :more/components-someone-needs
 {:when {:has :component/kind}
  :require [{:or [{:used-by {:some {:has :fn/reads}}} {:has :component/optional}]}]}

 :more/no-fn-depends-on-pii
 {:when {:has :fn/reads}
  :require [{:deps {:none {:= {:data/privacy :pii}}}}]}

 :more/pii-has-a-producer
 {:when {:= {:data/privacy :pii}}
  :require [{:producers {:some {:kind :edn}}}]}}
