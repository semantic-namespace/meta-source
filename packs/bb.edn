;; meta-source's packs for Clojure libraries: their checks run here, with
;; the core (..) on the classpath.
{:paths ["src" "resources" "bb"]
 :deps {io.github.semantic-namespace/meta-source {:local/root ".."}}
 :tasks {meta-source {:doc "meta-source with these packs on the classpath: bb meta-source check --root examples/billing"
                      :requires ([meta-source.cli])
                      :task (apply meta-source.cli/-main *command-line-args*)}
         smoke {:doc "The packs' checks, one suite each (bb/smoke/): the shop fixture, one per pack. bb smoke [suite ...]"
                :requires ([smoke])
                :task (apply smoke/-main *command-line-args*)}
         jvm-check {:doc "Loads every pack on the JVM and checks the shop fixture's index matches babashka's. Needs the clojure CLI."
                    :requires ([jvm-check])
                    :task (jvm-check/-main)}
         system-snapshot-check {:doc "Runs the integrant and reitit packs' runtime-entities against real integrant and reitit and checks what they give. Needs the clojure CLI."
                                :requires ([system-snapshot-check])
                                :task (system-snapshot-check/-main)}
         pathom-snapshot-check {:doc "Rebuilds the shop fixture's Pathom snapshot from real Pathom 3 and 2 and checks it matches the committed one. Needs the clojure CLI."
                                :requires ([pathom-snapshot-check])
                                :task (pathom-snapshot-check/-main)}}}
